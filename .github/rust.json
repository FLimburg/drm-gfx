{
  "problemMatcher": [
    {
      "owner": "rust",
      "pattern": [
        {
          "regexp": "^(warning|error)(\\[([^\\]]+)\\])?: (.*)$",
          "severity": 1,
          "message": 4,
          "code": 3
        },
        {
          "regexp": "^\\s*-->\\s*([^:]+):(\\d+):(\\d+)\\s*$",
          "file": 1,
          "line": 2,
          "column": 3
        }
      ]
    }
  ]
}
